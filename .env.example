# Founder AI - Local Config Environment Variables

# LLM Downloader Details
LLM_REPO_ID=bartowski/Llama-3.2-3B-Instruct-GGUF
LLM_FILENAME=Llama-3.2-3B-Instruct-Q4_K_M.gguf

# Local Directories
MODEL_DIR=models
CHROMA_DB_DIR=chroma_db

# Local Embedding Model (LangChain HuggingFace Embeddings)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# LLM Execution Hyperparameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000
LLM_N_CTX=4096

# Provider API Keys (Stored locally in .env — NEVER committed to repo)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here

# Payment Gateway Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
CIRCLE_API_KEY=your_circle_api_key

